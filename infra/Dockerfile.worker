# Playwright base image ships headless Chromium + system deps.
FROM mcr.microsoft.com/playwright:v1.50.0-noble AS base
RUN corepack enable
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/worker/package.json apps/worker/
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY packages/renderer/package.json packages/renderer/
RUN pnpm install --frozen-lockfile --filter @blackroom/worker... --filter @blackroom/db... --filter @blackroom/renderer...

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/db packages/db
COPY packages/renderer packages/renderer
COPY apps/worker apps/worker

EXPOSE 3001
CMD ["pnpm", "--filter", "@blackroom/worker", "start"]
