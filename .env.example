# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_APP_URL=

# Gemini (use a PAID tier — free tiers may train on inputs)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Supabase (DB + Storage only; auth is Telegram)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=blackroom
# Direct Postgres connection string (Supabase → Project Settings → Database).
# Needed for migrations and FOR UPDATE SKIP LOCKED job polling — PostgREST is not enough.
DATABASE_URL=

# App
JWT_SECRET=
SUPERADMIN_TELEGRAM_ID=
DEFAULT_RETENTION_HOURS=24

# Deploy (docker compose only — not read by the apps)
# Token for the Cloudflare tunnel that serves PUBLIC_APP_URL.
CLOUDFLARE_TUNNEL_TOKEN=
